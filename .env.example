# Produksi: APP_ENV=production, APP_DEBUG=false, APP_URL=https://domain-anda
APP_NAME="Sistem Absensi Sekolah"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sistem_absensi_sekolah
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
# Lokal boleh sync; production Web Push disarankan database + queue worker.
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
# Logout pengguna setelah tidak ada aktivitas selama jumlah menit ini.
SESSION_IDLE_TIMEOUT=10
# Beri cadangan di atas idle timeout agar proses logout tidak berbenturan dengan session server.
SESSION_LIFETIME=15

# ------------------------------------------------------------------
# KEAMANAN — WAJIB diaktifkan saat produksi (HTTPS).
# ------------------------------------------------------------------
# Kirim cookie sesi hanya lewat HTTPS.
SESSION_SECURE_COOKIE=false
# Enkripsi isi file sesi di disk.
SESSION_ENCRYPT=false
# Batasi cookie ke domain produksi Anda. Isi DOMAIN POLOS saja
# (mis. absensi.contoh.sch.id) — JANGAN pakai https:// atau trailing slash.
SESSION_DOMAIN=null
# Paksa semua URL memakai skema https (set true saat produksi di balik HTTPS).
FORCE_HTTPS=false

# Cloudflare Turnstile untuk melindungi form login. Boleh false saat
# pengembangan lokal, tetapi wajib true beserta key/hostname saat produksi.
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAME=

# Daftar CIDR proxy yang dipercaya, dipisah koma. Kosongkan bila aplikasi
# tidak berada di belakang reverse proxy. JANGAN memakai '*'.
TRUSTED_PROXIES=

# Identitas sekolah untuk laporan dan API integrasi.
SCHOOL_NAME=
SCHOOL_CITY=
SCHOOL_HEAD_TITLE=Kepala Madrasah

# Secret integrasi API laporan absensi. Kosongkan bila tidak dipakai.
AIO_INTEGRATION_API_KEY=
# Isi sementara saat rotasi key; hapus setelah seluruh consumer memakai key baru.
AIO_INTEGRATION_PREVIOUS_API_KEY=
AIO_INTEGRATION_REQUIRE_HTTPS=true
# Daftar origin yang diizinkan CORS (pisahkan koma). Default: APP_URL.
CORS_ALLOWED_ORIGINS="${APP_URL}"
# Aktif/nonaktifkan Content-Security-Policy header (biarkan true).
SECURITY_CSP_ENABLED=true

# Progressive Web App dan Web Push VAPID.
PWA_ENABLED=true
PUSH_ENABLED=false
PUSH_VAPID_SUBJECT=mailto:admin@example.com
PUSH_VAPID_PUBLIC_KEY=
PUSH_VAPID_PRIVATE_KEY=
PUSH_TTL=300
PUSH_RETRY_AFTER_SECONDS=300
PUSH_RATE_LIMIT_PER_MINUTE=10
# Host Web Push tepercaya, pisahkan koma. Wildcard hanya didukung sebagai awalan *.
PUSH_ALLOWED_HOSTS=updates.push.services.mozilla.com,fcm.googleapis.com,*.push.apple.com,*.notify.windows.com

# Service face recognition lokal yang dijalankan melalui Docker Compose.
# Gunakan nilai API key acak yang sama untuk Laravel dan container FastAPI.
FACE_SERVICE_URL=http://127.0.0.1:8001
FACE_SERVICE_API_KEY=
FACE_SERVICE_CONNECT_TIMEOUT=3
FACE_SERVICE_TIMEOUT=45
FACE_LIVENESS_REQUIRED=false
FACE_LIVENESS_CHALLENGE_TTL_SECONDS=90
FACE_LIVENESS_AUDIT_RETENTION_DAYS=90
FACE_STATUS_RATE_LIMIT_PER_MINUTE=60
FACE_CHALLENGE_RATE_LIMIT_PER_MINUTE=15
FACE_ENROLLMENT_RATE_LIMIT_PER_MINUTE=8
FACE_ATTENDANCE_RATE_LIMIT_PER_MINUTE=10
FACE_LEGACY_ENDPOINTS_ENABLED=false

# Batas akurasi GPS (meter) dan retensi foto absensi.
# max_gps_accuracy per lokasi di database menang bila diisi; nilai ini jadi default.
ATTENDANCE_MAX_GPS_ACCURACY_METERS=100
# Hapus foto audit absensi setelah jumlah hari ini. Record absensi tetap disimpan.
ATTENDANCE_PHOTO_RETENTION_DAYS=30

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
